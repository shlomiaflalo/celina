node_modules/
dist/
uploads/

# копии-конфликты iCloud («dist 2», «node_modules 3», «celina 2.mp4»…). iCloud
# оставляет их как dataless-заглушки: ls показывает имена, а чтение падает с ENOENT.
# Tailwind сканирует исходники по .gitignore, поэтому без этих правил сборщик
# читает заглушку и роняет дев-сервер оверлеем.
* [0-9]/
* [0-9].*

*.db
*.db-journal
.env
.DS_Store

# приватные документы верификации (паспорта) — только рантайм, НИКОГДА в git (ФЗ-152)
uploads-private/
backend/uploads-private/

# промо-видео (23 МБ) в публичный репозиторий не кладём — это не код,
# и оно раздувает клон. В проде файл лежит в frontend/public/ рядом со сборкой.
frontend/public/celina.mp4
