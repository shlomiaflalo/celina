# ───────────────────────────────────────────────────────────────
#  Celina — пример переменных окружения
#  Скопируйте этот файл в  .env  и заполните значения.
#    cp .env.example .env
#  Файл  .env  НЕ коммитится в git (секреты).
# ───────────────────────────────────────────────────────────────

# ── Среда ──
# development | production
NODE_ENV=development
# Порт API-сервера (по умолчанию 4000)
PORT=4000

# ── База данных (Prisma / SQLite) ──
DATABASE_URL="file:./dev.db"

# ── Публичный домен сайта ──
# Нужен для CORS-политики, OG-инъекции и IndexNow-пинга (Яндекс).
# ОБЯЗАТЕЛЬНО задайте свой реальный домен в проде (тот же, что VITE_SITE_URL при сборке фронта).
SITE_URL=https://ваш-домен

# ── Доверенные прокси (rate-limit / реальный IP) ──
# 0 = контейнер опубликован напрямую (docker compose, порт 80:4000) — НЕ доверять
#     заголовку X-Forwarded-For (иначе rate-limit обходится подделкой XFF).
# 1 = за одним обратным прокси (nginx) — брать реальный IP из XFF от nginx.
TRUST_PROXY=0

# ── IndexNow (быстрая индексация в Яндексе) — необязательно ──
# Ключ должен совпадать с именем файла frontend/public/<KEY>.txt (по умолчанию встроен).
# INDEXNOW_KEY=8edae11c797769c3b915396a36f69e51

# ── JWT ──
# Секрет для подписи токенов. В проде ОБЯЗАТЕЛЬНО замените на длинную
# случайную строку, например:  openssl rand -base64 48
JWT_SECRET=замените-на-длинный-случайный-секрет

# ── E-mail (SMTP) — коды сброса пароля и 2FA основателя ──
# Аккаунт Celina: celinarussia.support@gmail.com
# Gmail: 1) включите 2FA в этом Google-аккаунте;
#        2) создайте «Пароль приложения» (16 символов) — https://myaccount.google.com/apppasswords
#        3) вставьте его в SMTP_PASS (это НЕ обычный пароль от почты).
# Порт 465 = SSL, порт 587 = STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=celinarussia.support@gmail.com
SMTP_PASS=вставьте-16-значный-пароль-приложения-google
# Имя и адрес отправителя (если пусто — берётся SMTP_USER)
MAIL_FROM=Celina <celinarussia.support@gmail.com>

# ── SMS (Twilio) — коды на телефон ──
# Консоль: https://console.twilio.com  →  Account SID / Auth Token
# TWILIO_FROM — ваш номер Twilio в формате E.164 (+1...)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=вставьте-auth-token
TWILIO_FROM=+10000000000

# ── Биллинг: разовая активация повара ($1) через ЮKassa (Сбер) ──
# ВАЖНО для основателя-нерезидента (Израиль и т.п.): обычная регистрация на
# yookassa.ru — только для резидентов РФ (поэтому она и не проходит).
# Используйте программу для ИНОСТРАННЫХ компаний:  https://yookassa.ru/non-russian-residents/
# — она позволяет иностранной компании принимать оплату с российских карт (Мир),
#   Сбербанк/Т-Банк/ЮMoney. После онбординга вы получаете shopId + секретный ключ.
# Нюансы нерезидента: нужна иностранная КОМПАНИЯ (не физлицо), бумажный договор,
#   выплаты — на кошелёк ЮMoney (не напрямую на зарубежный банк), СБП недоступен.
# Код интеграции уже готов — нужны только ключи ниже (менять код не требуется).
BILLING_PROVIDER=yookassa
YOOKASSA_SHOP_ID=вставьте-shopId
YOOKASSA_SECRET_KEY=вставьте-секретный-ключ
ACTIVATION_RUB=100          # сумма списания ≈ $1
ACTIVATION_USD=1
# Если YOOKASSA_* не заданы — активация работает в режиме СИМУЛЯЦИИ
# (форма карты в dev; реальные деньги не списываются).

# ── Примечание ──
# Если SMTP или Twilio не настроены, коды НЕ отправляются провайдером,
# а пишутся в лог сервера (и в dev-режиме возвращаются в ответе как devCode).
# В production без настроенных провайдеров коды доставлены не будут.
